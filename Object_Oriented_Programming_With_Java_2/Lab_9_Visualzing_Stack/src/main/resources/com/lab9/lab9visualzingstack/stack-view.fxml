<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="30.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.2-ea" fx:controller="com.lab9.lab9visualzingstack.StackController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <!-- Top Input Section-->
    <HBox alignment="CENTER" spacing="15.0">
        <TextField fx:id="inputField" promptText="Enter value " styleClass="input-field" prefWidth="200"/>
        <Button onAction="#onPushClick" styleClass="action-btn" text="Push" />
        <Button onAction="#onPopClick" styleClass="action-btn" text="Pop" />
        <Button onAction="#onClearClick" styleClass="action-btn" text="Clear" />
    </HBox>

    <!-- Message Area -->
    <Label fx:id="messageLabel" text="Top" styleClass="stack-label"/>

    <!-- Stack Visualization -->
    <VBox fx:id="stackContainer" alignment="TOP_CENTER" spacing="8.0" VBox.vgrow="ALWAYS" prefHeight="350.0" prefWidth="300.0"
          styleClass="stack-container">
        <!-- Stack items will appear here dynamically -->
        <padding>
            <Insets top="20.0" bottom="20.0" right="20.0" left="20.0" />
        </padding>
    </VBox>
</VBox>
